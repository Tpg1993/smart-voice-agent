# General Config
ENVIRONMENT=development
PORT=8000

# Security Credentials
# The secret used for symmetric AES/JWT signing. Change this in production!
JWT_SECRET_KEY="your-strong-random-jwt-secret-key-here"
# The default mock admin password used in routes.py
ADMIN_PASSWORD="super_secret_admin_password_123"

# Sarvam AI Specific (Add keys here when ready)
SARVAM_API_KEY="your-sarvam-api-key"
SARVAM_BASE_URL="https://api.sarvam.ai"

# Local Database Credentials
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secure_postgres_password_here"

# Application Connections
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/voice_agent_db"
REDIS_URL="redis://localhost:6379/0"
